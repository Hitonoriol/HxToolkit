<RCC>
    <qresource prefix="/icons">
        <file>icon-app.ico</file>
        <file>refresh.svg</file>
        <file>clock.svg</file>
        <file>play.svg</file>
        <file>pause.svg</file>
        <file>expand.svg</file>
        <file>collapse.svg</file>
        <file>tool-move-up.svg</file>
        <file>tool-move-down.svg</file>
        <file>tool-expand.svg</file>
        <file>tool-collapse.svg</file>
        <file>tool-close.svg</file>
        <file>split-horizontal.svg</file>
        <file>split-vertical.svg</file>
    </qresource>
    <qresource prefix="/themes">
        <file alias="qlementine-dark.json">themes/qlementine-dark.json</file>
    </qresource>
</RCC>
